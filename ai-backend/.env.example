APP_NAME=leaseaccom AI
APP_ENV=development
ALLOW_DEMO_AUTH=false

# Frontend origins allowed to call the AI backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://localhost:8080,http://localhost:5500,https://adesolaenoch123.github.io

# Supabase server-side configuration. Keep these on the backend only.
SUPABASE_URL=https://jxbraodoqfwagefsynlc.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider configuration. Property Page  secrets in .env, never in source control.
LLM_API_KEY=your_llm_api_key
LLM_API_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-4o-mini
